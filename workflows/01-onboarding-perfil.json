              "name": "apikey",
              "value": "TU_SERVICE_ROLE_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer TU_SERVICE_ROLE_KEY"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"clerk_user_id\": \"{{ $json.clerk_user_id }}\",\n  \"nombre\": \"{{ $json.nombre }}\",\n  \"disciplina\": \"{{ $json.disciplina }}\",\n  \"meta_actual\": \"{{ $json.meta_actual }}\"\n}",
        "options": {}
      },
