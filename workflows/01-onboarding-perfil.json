      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Extrae los campos de Clerk (evento directo o datos simulados)\nconst body = $input.first().json.body || $input.first().json;\nconst data = body.data || body;\n\nconst clerkUserId = data.id || 'user_clerk_demo_camila';\nconst nombre = [data.first_name, data.last_name].filter(Boolean).join(' ') || data.nombre || 'Nueva Creadora';\nconst disciplina = data.disciplina || data.unsafe_metadata?.disciplina || 'Ilustración y dibujo';\nconst metaActual = data.meta_actual || data.unsafe_metadata?.meta_actual || 'Dominar anatomía y proporciones';\n\nreturn [{\n  json: {\n    clerk_user_id: clerkUserId,\n    nombre: nombre,\n    disciplina: disciplina,\n    meta_actual: metaActual,\n    evento: body.type || 'user.created'\n  }\n}];"
      },
